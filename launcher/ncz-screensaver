    "hack-idle-delay": 300,
    "cycle-delay": 600,
    "lock-enabled": False,
    "lock-delay": 60,
    "lock-on-suspend": True,
    "display-off-delay": 0,
    "blackhole-color-mode": "stylized",
    "verify-render": True,
