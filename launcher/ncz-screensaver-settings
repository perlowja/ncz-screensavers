LOCK_MINUTES_MAX = 240
DISPLAY_MINUTES_MIN = 0
DISPLAY_MINUTES_MAX = 240


# ---------------------------------------------------------------------------
# Catalog / installed-hack helpers
# ---------------------------------------------------------------------------


def catalog_path() -> str | None:
    """Return the first existing TSV catalog file."""
    for c in CATALOG_CANDIDATES:
        if c and os.path.isfile(c):
            return c
    return None


def hack_dirs() -> list[str]:
    """Return the de-duplicated list of dirs to search for hack binaries."""
    env = HACK_DIR_CANDIDATES[0]
    raw = env.split(":") if env else HACK_DIR_CANDIDATES[1:]
    seen: set[str] = set()
    keep: list[str] = []
    for d in raw:
        if d and d not in seen and os.path.isdir(d):
            seen.add(d)
            keep.append(d)
    return keep


def load_catalog() -> list[dict]:
    """Parse the TSV catalog into list[{id,title,group}] dicts."""
    path = catalog_path()
    if not path:
        return []
    rows: list[dict] = []
    try:
        with open(path, encoding="utf-8") as f:
            for raw in f:
                line = raw.rstrip("\n")
                if not line or line.startswith("#"):
                    continue
                fields = line.split("\t")
                if len(fields) < 3:
                    continue
                rows.append({"id": fields[0], "title": fields[1], "group": fields[2]})
    except OSError:
        return []
    return rows


def is_installed(hack_id: str, dirs: list[str]) -> bool:
    """Return True when an executable named hack_id exists in any search dir."""
    return any(os.path.isfile(os.path.join(d, hack_id)) for d in dirs)


def build_catalog_view(catalog: list[dict], dirs: list[str]) -> list[dict]:
    """Combine the catalog with installation status; used by --dump."""
    return [{**row, "installed": is_installed(row["id"], dirs)} for row in catalog]


# ---------------------------------------------------------------------------
# GSettings access
# ---------------------------------------------------------------------------


def open_settings() -> Gio.Settings | None:
    """Open the dev.ncz.screensaver schema; None if missing.

    Gio.Settings.new() aborts the process when the schema is missing, so
    look up the schema first via Gio.SettingsSchemaSource.
    """
    try:
        src = Gio.SettingsSchemaSource.get_default()
    except GLib.Error as e:
        sys.stderr.write(f"settings: no schema source: {e}\n")
        return None
    if src is None:
        sys.stderr.write("settings: no default schema source\n")
        return None
    schema = src.lookup(SCHEMA_ID, True)
    if schema is None:
        sys.stderr.write(f"settings: schema '{SCHEMA_ID}' not installed\n")
        return None
    try:
        return Gio.Settings.new_full(schema, None, None)
    except GLib.Error as e:
        sys.stderr.write(f"settings: cannot open '{SCHEMA_ID}': {e}\n")
        return None


def read_dump(settings: Gio.Settings, catalog_view: list[dict]) -> dict:
    """Compose the JSON shape required by --dump."""
    pool = settings.get_strv("random-hacks")
    return {
        "mode": settings.get_string("mode"),
        "hack_id": settings.get_string("hack-id"),
        "random_hacks": pool,
        "idle_minutes": settings.get_int("hack-idle-delay") // 60,
        "catalog": [
            {
                "id": r["id"],
                "title": r["title"],
                "group": r["group"],
                "installed": r["installed"],
                "enabled": (not pool) or r["id"] in pool,
            }
            for r in catalog_view
        ],
        "color": settings.get_string("blackhole-color-mode"),
    }


# ---------------------------------------------------------------------------
# Subprocess helpers
# ---------------------------------------------------------------------------


def run_subprocess(args: list[str]) -> None:
    """Run a `ncz-screensaver` command non-blocking via Gio.Subprocess."""
    flags = Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE
    try:
        proc = Gio.Subprocess.new(args, flags)
    except GLib.Error as e:
        sys.stderr.write(f"spawn {args}: {e}\n")
        return
    # Drain pipes asynchronously so the child never blocks on full buffers.
    proc.communicate_utf8_async(None, None, None)


def preview_blackhole() -> None:
    run_subprocess(["ncz-screensaver", "preview", "blackhole_gles3", "--seconds", "20"])


def preview_hack(hack_id: str) -> None:
    run_subprocess(["ncz-screensaver", "preview", hack_id, "--seconds", "15"])


def stop_preview() -> None:
    run_subprocess(["ncz-screensaver", "stop"])


# ---------------------------------------------------------------------------
# Main window
# ---------------------------------------------------------------------------


class ScreensaverWindow(Adw.ApplicationWindow):
    """The single Screensaver & Lock settings/chooser window."""

    def __init__(self, app: Adw.Application, settings: Gio.Settings) -> None:
        super().__init__(application=app)
        self._settings = settings
        # Guard flag: skip writes triggered by our own GSettings callbacks so
        # external "changed" handlers do not produce feedback loops.
        self._suppress_changed = False

        self.set_title("Screensaver & Lock")
        self.set_default_size(720, 760)
        # Default to dark, mirroring the 57-screensaver look.
        self.add_css_class("night")

        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()

        stop_btn = Gtk.Button.new_with_label("Stop preview")
        stop_btn.set_valign(Gtk.Align.CENTER)
        stop_btn.connect("clicked", lambda *_a: stop_preview())
        header.pack_end(stop_btn)

        self._search = Gtk.SearchEntry()
        self._search.set_placeholder_text("Search hacks…")
        self._search.set_valign(Gtk.Align.CENTER)
        self._search.set_hexpand(True)
        header.pack_start(self._search)

        toolbar.add_top_bar(header)

        page = Adw.PreferencesPage()
        toolbar.set_content(page)
        self.set_content(toolbar)

        self._build_screensaver_group(page)
        self._build_lock_group(page)
        self._build_color_group(page)
        self._build_verify_group(page)
        self._build_hack_groups(page)

        self._search.connect("search-changed", self._on_search_changed)
        self._connect_settings_signals()
        self._refresh_from_settings()

    # ---- groups -----------------------------------------------------------

    def _build_screensaver_group(self, page: Adw.PreferencesPage) -> None:
        grp = Adw.PreferencesGroup.new()
        grp.set_title("Screensaver")
        page.add(grp)

        self._mode_row = Adw.ComboRow.new()
        self._mode_row.set_title("Mode")
        self._mode_model = Gtk.StringList.new([MODE_LABEL[n] for n in MODE_NICKS])
        self._mode_row.set_model(self._mode_model)
        self._mode_row.connect("notify::selected", self._on_mode_changed)
        grp.add(self._mode_row)

        self._idle_row = Adw.SpinRow.new_with_range(MINUTES_MIN, MINUTES_MAX, 1)
        self._idle_row.set_title("Start after (minutes)")
        self._idle_row.set_subtitle(
            "Minutes of inactivity before the screensaver starts"
        )
        self._idle_row.connect("changed", self._on_idle_changed)
        grp.add(self._idle_row)

        self._cycle_row = Adw.SpinRow.new_with_range(MINUTES_MIN, MINUTES_MAX, 1)
        self._cycle_row.set_title("Rotate every (minutes)")
        self._cycle_row.set_subtitle("Each hack runs this long in random / playlist")
        self._cycle_row.connect("changed", self._on_cycle_changed)
        grp.add(self._cycle_row)

    def _build_lock_group(self, page: Adw.PreferencesPage) -> None:
        grp = Adw.PreferencesGroup.new()
        grp.set_title("Lock and display")
        page.add(grp)

        self._lock_enabled_row = Adw.SwitchRow.new()
        self._lock_enabled_row.set_title("Lock after screensaver")
        self._lock_enabled_row.connect("notify::active", self._on_lock_enabled_changed)
        grp.add(self._lock_enabled_row)

        self._lock_delay_row = Adw.SpinRow.new_with_range(
            LOCK_MINUTES_MIN, LOCK_MINUTES_MAX, 1
        )
        self._lock_delay_row.set_title("Lock after (minutes)")
        self._lock_delay_row.connect("changed", self._on_lock_delay_changed)
        grp.add(self._lock_delay_row)

        self._lock_on_suspend_row = Adw.SwitchRow.new()
        self._lock_on_suspend_row.set_title("Lock on suspend")
        self._lock_on_suspend_row.connect(
            "notify::active", self._on_lock_on_suspend_changed
        )
        grp.add(self._lock_on_suspend_row)

        self._display_off_row = Adw.SpinRow.new_with_range(
            DISPLAY_MINUTES_MIN, DISPLAY_MINUTES_MAX, 1
        )
        self._display_off_row.set_title("Turn display off after (minutes)")
        self._display_off_row.set_subtitle("0 = never")
        self._display_off_row.connect("changed", self._on_display_off_changed)
        grp.add(self._display_off_row)

    def _build_color_group(self, page: Adw.PreferencesPage) -> None:
        grp = Adw.PreferencesGroup.new()
        grp.set_title("Black hole color")
        page.add(grp)

        self._color_row = Adw.ComboRow.new()
        self._color_row.set_title("Color model")
        # The dropdown labels are recomputed in _refresh_color_combo() once
        # the live settings value is known; populate with the canonical three
        # nicks first.
        self._color_model = Gtk.StringList.new([COLOR_LABEL[n] for n in COLOR_NICKS])
        self._color_row.set_model(self._color_model)
        self._color_row.connect("notify::selected", self._on_color_changed)
        grp.add(self._color_row)

        preview_row = Adw.ActionRow.new()
        preview_row.set_title("Preview black hole")
        preview_row.set_subtitle(
            "Run blackhole_gles3 for 20 seconds with the selected color model"
        )
        btn = Gtk.Button.new_with_label("Preview black hole")
        btn.set_valign(Gtk.Align.CENTER)
        btn.connect("clicked", lambda *_a: preview_blackhole())
        preview_row.add_suffix(btn)
        preview_row.set_activatable_widget(btn)
        grp.add(preview_row)

    def _build_verify_group(self, page: Adw.PreferencesPage) -> None:
        grp = Adw.PreferencesGroup.new()
        grp.set_title("Detect black screensavers")
        page.add(grp)

        self._verify_row = Adw.SwitchRow.new()
        self._verify_row.set_title(
            "Treat a fully black frame as a failure and move to the next hack"
        )
        self._verify_row.connect("notify::active", self._on_verify_changed)
        grp.add(self._verify_row)

    def _build_hack_groups(self, page: Adw.PreferencesPage) -> None:
        """One Adw.PreferencesGroup per catalog group; rows are action rows."""
        self._catalog = load_catalog()
        self._dirs = hack_dirs()
        self._installed = {
            row["id"]: is_installed(row["id"], self._dirs) for row in self._catalog
        }

        # Preserve canonical catalog order (matches the order of hacks.tsv).
        groups: dict[str, list[dict]] = {}
        order: list[str] = []
        for row in self._catalog:
            g = row["group"]
            if g not in groups:
                order.append(g)
                groups[g] = []
            groups[g].append(row)

        self._rows_by_id: dict[str, dict] = {}
        self._first_radio: Gtk.CheckButton | None = None

        for group_name in order:
            rows = groups[group_name]
            grp = Adw.PreferencesGroup.new()
            grp.set_title(f"{group_name} ({len(rows)})")
            page.add(grp)

            for r in rows:
                installed = self._installed[r["id"]]
                ar = Adw.ActionRow.new()
                ar.set_title(r["title"])
                ar.set_subtitle(r["id"] if installed else "not installed")
                if not installed:
                    # Dim rows whose binary is missing; they cannot be previewed.
                    ar.add_css_class("dimmed")
                grp.add(ar)

                # Prefix: a radio Gtk.CheckButton (group behavior) only shown
                # when the current mode is "one"; visibility is toggled in
                # _refresh_radio().
                radio = Gtk.CheckButton.new()
                radio.set_valign(Gtk.Align.CENTER)
                if self._first_radio is None:
                    self._first_radio = radio
                else:
                    radio.set_group(self._first_radio)
                radio.connect("toggled", self._on_radio_toggled, r["id"])
                ar.add_prefix(radio)

                # Suffix: a Gtk.Switch indicating membership in random-hacks.
                # When random-hacks is empty every switch shows on; toggling
                # one off materializes the full list minus that id, and if the
                # resulting list equals the whole catalog it is stored as [].
                sw = Gtk.Switch.new()
                sw.set_valign(Gtk.Align.CENTER)
                sw.connect("notify::active", self._on_pool_toggled, r["id"])
                if not installed:
                    sw.set_sensitive(False)
                ar.add_suffix(sw)

                btn = Gtk.Button.new_with_label("Preview")
                btn.set_valign(Gtk.Align.CENTER)
                if installed:
                    btn.connect("clicked", self._on_preview_clicked, r["id"])
                else:
                    btn.set_sensitive(False)
                ar.add_suffix(btn)

                self._rows_by_id[r["id"]] = {"row": ar, "radio": radio, "switch": sw}

    # ---- settings signal wiring ------------------------------------------

    def _connect_settings_signals(self) -> None:
        # Listen to every key we read so external CLI/plugin writes refresh
        # the UI; the guard flag prevents our own writes from echoing back.
        for key in (
            "mode",
            "hack-id",
            "random-hacks",
            "hack-idle-delay",
            "cycle-delay",
            "lock-enabled",
            "lock-delay",
            "lock-on-suspend",
            "display-off-delay",
            "blackhole-color-mode",
            "verify-render",
        ):
            self._settings.connect(f"changed::{key}", self._on_setting_changed)

    # ---- refresh helpers --------------------------------------------------

    def _refresh_from_settings(self) -> None:
        """Push current GSettings state into all widgets."""
        self._suppress_changed = True
        try:
            mode = self._settings.get_string("mode")
            self._mode_row.set_selected(_safe_index(MODE_NICKS, mode))
            self._idle_row.set_value(self._settings.get_int("hack-idle-delay") // 60)
            self._cycle_row.set_value(self._settings.get_int("cycle-delay") // 60)
            self._lock_enabled_row.set_active(
                self._settings.get_boolean("lock-enabled")
            )
            self._lock_delay_row.set_value(self._settings.get_int("lock-delay") // 60)
            self._lock_on_suspend_row.set_active(
                self._settings.get_boolean("lock-on-suspend")
            )
            self._display_off_row.set_value(
                self._settings.get_int("display-off-delay") // 60
            )
            self._verify_row.set_active(self._settings.get_boolean("verify-render"))
            self._refresh_color_combo(self._settings.get_string("blackhole-color-mode"))
            self._refresh_pool_switches()
            self._refresh_radio()
        finally:
            self._suppress_changed = False

    def _refresh_color_combo(self, current: str) -> None:
        """Rebuild the color combo entries; preserve the current value."""
        labels = [COLOR_LABEL[n] for n in COLOR_NICKS]
        nicks = list(COLOR_NICKS)
        if current not in nicks:
            nicks.append(current)
            labels.append(f"Custom: {current}")
        self._color_model.splice(0, self._color_model.get_n_items(), labels)
        self._color_row.set_selected(_safe_index(nicks, current))
        # Stash nick list for the change handler.
        self._color_nicks = nicks

    def _refresh_pool_switches(self) -> None:
        """Update each hack's random-pool switch from current random-hacks."""
        pool = set(self._settings.get_strv("random-hacks"))
        active = not pool  # Empty pool means every hack is "enabled".
        for hack_id, entry in self._rows_by_id.items():
            entry["switch"].set_active(active or hack_id in pool)

    def _refresh_radio(self) -> None:
        """Update the radio widget states and visibility."""
        mode = self._settings.get_string("mode")
        show_radio = mode == "one"
        current_hack = self._settings.get_string("hack-id")
        for hack_id, entry in self._rows_by_id.items():
            radio = entry["radio"]
            radio.set_visible(show_radio)
            radio.set_sensitive(show_radio and self._installed[hack_id])
            if hack_id == current_hack:
                radio.set_active(True)

    # ---- mode / color change handlers ------------------------------------

    def _write_combo(
        self,
        row: Adw.ComboRow,
        _pspec: GObject.ParamSpec,
        nicks: tuple[str, ...] | list[str],
        key: str,
    ) -> None:
        """Write the selected combo entry into a string GSettings key."""
        if self._suppress_changed:
            return
        idx = row.get_selected()
        if 0 <= idx < len(nicks):
            self._settings.set_string(key, nicks[idx])

    def _on_mode_changed(self, row: Adw.ComboRow, pspec: GObject.ParamSpec) -> None:
        self._write_combo(row, pspec, MODE_NICKS, "mode")

    def _on_color_changed(self, row: Adw.ComboRow, pspec: GObject.ParamSpec) -> None:
        nicks = getattr(self, "_color_nicks", list(COLOR_NICKS))
        self._write_combo(row, pspec, nicks, "blackhole-color-mode")

    # ---- integer/minute rows ---------------------------------------------

    def _write_int_minutes(self, key: str, row: Adw.SpinRow) -> None:
        """Write a minutes-bound SpinRow value into an integer GSettings key."""
        if self._suppress_changed:
            return
        self._settings.set_int(key, int(row.get_value()) * 60)

    def _write_bool(
        self, key: str, row: Adw.SwitchRow, _pspec: GObject.ParamSpec
    ) -> None:
        """Write a SwitchRow active state into a boolean GSettings key."""
        if self._suppress_changed:
            return
        self._settings.set_boolean(key, row.get_active())

    def _on_idle_changed(self, row: Adw.SpinRow) -> None:
        self._write_int_minutes("hack-idle-delay", row)

    def _on_cycle_changed(self, row: Adw.SpinRow) -> None:
        self._write_int_minutes("cycle-delay", row)

    def _on_lock_enabled_changed(
        self, row: Adw.SwitchRow, pspec: GObject.ParamSpec
    ) -> None:
        self._write_bool("lock-enabled", row, pspec)

    def _on_lock_delay_changed(self, row: Adw.SpinRow) -> None:
        self._write_int_minutes("lock-delay", row)

    def _on_lock_on_suspend_changed(
        self, row: Adw.SwitchRow, pspec: GObject.ParamSpec
    ) -> None:
        self._write_bool("lock-on-suspend", row, pspec)

    def _on_display_off_changed(self, row: Adw.SpinRow) -> None:
        self._write_int_minutes("display-off-delay", row)

    def _on_verify_changed(self, row: Adw.SwitchRow, pspec: GObject.ParamSpec) -> None:
        self._write_bool("verify-render", row, pspec)

    # ---- hack rows --------------------------------------------------------

    def _on_radio_toggled(self, btn: Gtk.CheckButton, hack_id: str) -> None:
        if self._suppress_changed:
            return
        if not btn.get_active():
            # Radio buttons fire toggled for both new and old; ignore the
            # deactivation so the choice isn't clobbered when another row
            # becomes active.
            return
        self._settings.set_string("hack-id", hack_id)

    def _on_pool_toggled(
        self, sw: Gtk.Switch, _pspec: GObject.ParamSpec, hack_id: str
    ) -> None:
        if self._suppress_changed:
            return
        all_ids = [r["id"] for r in self._catalog]
        current = self._settings.get_strv("random-hacks")
        # If the pool is empty today, toggling a switch materializes the full
        # set minus (or plus) the toggled id.
        if not current:
            new_pool = (
                list(all_ids)
                if sw.get_active()
                else [i for i in all_ids if i != hack_id]
            )
        else:
            new_pool = list(current)
            if sw.get_active() and hack_id not in new_pool:
                new_pool.append(hack_id)
            elif not sw.get_active() and hack_id in new_pool:
                new_pool.remove(hack_id)
        # Preserve catalog order; if the result covers everything store [].
        ordered = [i for i in all_ids if i in set(new_pool)]
        if set(ordered) == set(all_ids):
            self._settings.set_strv("random-hacks", [])
        else:
            self._settings.set_strv("random-hacks", ordered)

    def _on_preview_clicked(self, _btn: Gtk.Button, hack_id: str) -> None:
        preview_hack(hack_id)

    def _on_search_changed(self, entry: Gtk.SearchEntry) -> None:
        needle = entry.get_text().strip().lower()
        for e in self._rows_by_id.values():
            title = e["row"].get_title().lower()
            e["row"].set_visible(not needle or needle in title)

    # ---- external "changed" handler ---------------------------------------

    def _on_setting_changed(self, _settings: Gio.Settings, _key: str) -> None:
        if self._suppress_changed:
            return
        self._refresh_from_settings()


def _safe_index(values: list[str], value: str) -> int:
    """Return the index of value in values, or 0 if absent."""
    try:
        return values.index(value)
    except ValueError:
        return 0


# ---------------------------------------------------------------------------
# Application factory
# ---------------------------------------------------------------------------


class ScreensaverApp(Adw.Application):
    """Adwaita application; one window, the settings UI."""

    def __init__(self, settings: Gio.Settings) -> None:
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)
        self._settings = settings

    def do_activate(self) -> None:  # type: ignore[override]
        ScreensaverWindow(self, self._settings).present()


