SCHEMA_ID = "dev.ncz.screensaver"
APP_ID = "dev.ncz.screensaver"

# Default lookup paths (catalog then binary dirs).
CATALOG_CANDIDATES = [
    os.environ.get("NCZ_SCREENSAVER_CATALOG"),
    "/usr/share/ncz-screensavers/hacks.tsv",
    "/usr/share/ncz-screensaver-chooser/hacks.tsv",
]
HACK_DIR_CANDIDATES = [
    os.environ.get("NCZ_SCREENSAVER_DIRS"),
    "/usr/lib/ncz-screensavers",
    "/usr/libexec/ncz-screensavers",
    "/opt/ncz-screensavers/bin",
]

