def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(prog="ncz-screensaver-settings")
    p.add_argument("--dump", action="store_true", help="Print settings JSON and exit")
    p.add_argument(
        "--self-test",
        action="store_true",
        help="Drive the live UI, assert GSettings, exit 0/1/2",
    )
    return p.parse_args(argv)


def _run_error_window(app: Adw.Application, title: str, description: str) -> int:
    """Show a friendly status page when launched without a usable schema."""

    def on_activate(_a: Adw.Application) -> None:
        win = Adw.ApplicationWindow.new(app)
        win.set_title("Screensaver & Lock")
        win.set_default_size(520, 360)
        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        toolbar.add_top_bar(header)
        page = Adw.StatusPage.new()
        page.set_title(title)
        page.set_description(description)
        page.set_icon_name("preferences-desktop-screensaver-error")
        toolbar.set_content(page)
        win.set_content(toolbar)
        win.present()

    app.connect("activate", on_activate)
    return app.run(None)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    settings = open_settings()
    if settings is None:
        if args.dump:
            sys.stdout.write(json.dumps({"error": "schema-missing"}) + "\n")
            return 1
        app = Adw.Application.new(APP_ID, Gio.ApplicationFlags.FLAGS_NONE)
        return _run_error_window(
            app,
            "GSettings schema missing",
            "The dev.ncz.screensaver schema is not installed.",
        )

    if args.dump:
        catalog = build_catalog_view(load_catalog(), hack_dirs())
        sys.stdout.write(json.dumps(read_dump(settings, catalog), indent=2) + "\n")
        return 0

    if args.self_test:
        return run_self_test()

    return ScreensaverApp(settings).run(None)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
