#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- \
		-Dgl4es=disabled \
		-Dxscreensaver-shim=disabled \
		-Dinstall-extras=false

override_dh_auto_test:
	# The screensavers need a live Wayland compositor and GPU; the build
	# gate here is that the ship set links and installs.
	python3 tools/generate-catalog.py meson.build $(CURDIR)/debian/hacks.check.tsv
	diff -u assets/screensaver-chooser/hacks.tsv debian/hacks.check.tsv
	rm -f debian/hacks.check.tsv

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_dwz:
	# no debug packages are built; skip dwz so no /usr/lib/debug leaks in
